# Runtime and session databases
session/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.lock
*.sock
runtime/
state.db*
projects.db
kanban.db
logs/
cache/
audio_cache/
image_cache/

# Credentials and runtime configuration
.env
.env.*
!.env.example
config.yaml
auth.json
auth.lock
*.key
*.pem
*.token

# Fulfill-team skills and origin playbooks are local-only trade secrets.
workspace-ss-fulfill-*/skills/*
!workspace-ss-fulfill-*/skills/.gitkeep
**/*origin*
**/*playbook*
**/*fulfill-data*

# OS artifacts
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]

# Frontend dependencies
frontend/node_modules/
frontend/dist/
